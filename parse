#!/bin/sh
set -eu

cd "$(dirname "$0")"
background=0
case "${1:-}" in
    -h|--help)
        cat <<'USAGE'
./parse                        загрузить до 96 новых карточек SATAuto
./parse --details 24           ограничить запуск 24 подробными карточками
./parse --make toyota          выбрать марку из загруженного индекса
./parse index                 обновить полный индекс адресов SATAuto
./parse status                показать очередь SATAuto
./parse all                   запустить полный обход SATAuto в фоне
./parse logs                  посмотреть журнал полного обхода
./parse stop                  остановить полный обход
./parse carhub                собрать три страницы публичного CarHub
./parse init                  запустить каталог и подготовить БД
USAGE
        exit 0
        ;;
    index)
        shift
        set -- sitemap --all --store "$@"
        ;;
    status)
        shift
        set -- queue "$@"
        ;;
    logs)
        shift
        exec docker compose logs --tail=30 "$@" parser
        ;;
    stop)
        shift
        exec docker compose stop "$@" parser
        ;;
    all)
        if [ "$#" -ne 1 ]; then
            printf '%s\n' 'Использование: ./parse all' >&2
            exit 2
        fi
        background=1
        ;;
    carhub)
        shift
        set -- crawl --pages 3 "$@"
        ;;
    init|trim-build|trim-check)
        ;;
    *)
        set -- public-html --enrich --details 96 "$@"
        ;;
esac

if ! docker info >/dev/null 2>&1 && [ "$(uname -s)" = Darwin ]; then
    docker desktop start >&2
fi
docker compose up -d --wait >&2
if [ "$background" -eq 1 ]; then
    exec docker compose up -d parser
fi
exec docker compose run --rm --no-deps -T dashboard python -m catalog "$@"
